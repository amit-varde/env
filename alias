alias pbps='pbpaste'                                                   # Paste from clipboard

# Reload shell config (detects current shell and sources appropriate config file)
so() {
  case "$SHELL" in
    */zsh)   source ~/.zshrc ;;
    */bash)  source ~/.bashrc ;;
    */csh)   source ~/.cshrc ;;
    *)       echo "ERROR: Unknown shell: $SHELL"; return 1 ;;
  esac
  echo "Reloaded $(basename "$SHELL") configuration"
}

