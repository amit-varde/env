alias up='cd ..'                                                       # Go up one directory

# =============================================================================
# SYSTEM UTILITIES - Terminal and system settings
# =============================================================================
alias c='clear'                                                        # Clear the terminal screen
alias cls='clear'                                                      # Clear the terminal screen (alternative)
alias x='exit'                                                         # Exit the terminal
alias showfiles='defaults write com.apple.finder AppleShowAllFiles YES; killall Finder'  # Show hidden files in Finder
alias hidefiles='defaults write com.apple.finder AppleShowAllFiles NO; killall Finder'   # Hide hidden files in Finder
alias cleanup='find . -name "*.DS_Store" -type f -delete'              # Remove .DS_Store files
