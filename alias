# =============================================================================
# TOOLS - install front doors (live in tools/, not bin/)
# =============================================================================
env-install() {
    local install="$BU/tools/install.sh" a
    [ -x "$install" ] || { echo "Not found: $install" >&2; return 2; }
    for a in "$@"; do
        case "$a" in
            --list|--all|--tool|--dry-run|-y|--yes|-h|--help)
                "$install" "$@"
                return
                ;;
        esac
    done
    if [ $# -eq 0 ]; then "$install"; return; fi
    local args=()
    for a in "$@"; do
        case "$a" in
            all) args+=(--all) ;;
            -*) args+=("$a") ;;
            *) args+=(--tool "$a") ;;
        esac
    done
    "$install" "${args[@]}"
}
