#!/usr/bin/env bash
# =============================================================================
# File:        bin/run-py
# =============================================================================
#
# DESCRIPTION: Run Python script with output capture to log file
#   Executes a Python script and captures both stdout and stderr to a log file
#   while also displaying output in the terminal. Output is saved to RUN_OUT
#   environment variable location for later review.
#
# ARGUMENTS:
#   script.py    Path to Python script to execute
#   args...      Optional arguments passed to the Python script
#
# ENVIRONMENT VARIABLES:
#   RUN_OUT            Output file path (default: $PROJECT_WORKSPACE/$USER.run.out
#                      or /tmp/$USER.run.out if PROJECT_WORKSPACE not set)
#   PROJECT_WORKSPACE  Base directory for output files (optional)
#
# EXIT CODES:
#   0 - Script executed successfully
#   1 - No script specified or script not found
#   * - Exit code from the Python script
#
# USAGE:
#   run-py <script.py> [args...]
#   run-py -h | --help
#
# EXAMPLES:
#   # Run a Python script
#   run-py src/main.py
#
#   # Run with arguments
#   run-py src/process.py --input data.csv --output results.json
#
#   # Check output after running
#   run-py src/analyze.py && cat $RUN_OUT
#
#   # Custom output location
#   export RUN_OUT=~/logs/script.log
#   run-py src/task.py
#
# =============================================================================
set -euo pipefail

: "${BU:=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)}"
source "$BU/lib/common.bash"
handle_help "$@"

if [[ $# -eq 0 ]]; then
    err "No Python script specified."
    exit 1
fi
if [[ ! -f "$1" ]]; then
    err "Python script '$1' does not exist."
    exit 1
fi
py=$(command -v python || command -v python3) || { err "No python or python3 on PATH."; exit 1; }
exec "$BU/bin/run-cmd" "$py" "$@"
