#!/usr/bin/env bash
# =============================================================================
# File:        bin/create-work-shortcuts
# =============================================================================
#
# DESCRIPTION: One Desktop shortcut per project directory under $WORK
#   For every directory directly under $WORK (hidden ones skipped), writes
#   <Desktop>/<name>.code-workspace. Double-click it and your editor opens that
#   directory as a workspace. The files hold absolute paths for this machine, so
#   they are generated here and not kept in git.
#
#   Safe to re-run, and it only manages files it created:
#     - Each generated file starts with the comment
#         // generated by create-work-shortcuts
#       Files generated by the old name (work-shortcuts) are still managed.
#       Only files with that first line are ever updated or pruned.
#     - A file without it (hand-made, e.g. an older env.code-workspace, or a
#       remote-SSH workspace) is reported and left alone, unless --adopt.
#     - Whatever it replaces or removes is moved to
#       <Desktop>/.work-shortcuts-bak/<name>.code-workspace.<time>, never deleted.
#
#   Desktop folder: ~/Desktop (macOS); Linux: xdg-user-dir DESKTOP, else
#   ~/Desktop. If there is none (a headless host), it says so and does nothing.
#
# OPTIONS:
#   --list            Show the state of every directory and shortcut; change nothing
#   --dry-run         Show what would be created, updated or pruned; change nothing
#   --adopt           Also take over hand-made files with the same name
#                     (backed up first). --force is the same
#   --prune           Remove generated shortcuts whose directory no longer exists
#   --exclude NAME    Skip $WORK/NAME (repeatable; also WORK_SHORTCUTS_EXCLUDE,
#                     a space-separated list)
#   --work DIR        Directory holding the projects (default: $WORK)
#   --desktop DIR     Where to write the shortcuts (default: your Desktop)
#   -h, --help        Show this help
#
# ENVIRONMENT:
#   WORK                       Parent directory of your projects (set by .env.host)
#   WORK_SHORTCUTS_EXCLUDE     Names to skip, separated by spaces
#
# EXIT CODES:
#   0 - Done (hand-made files left alone are reported but are not an error)
#   1 - $WORK or the Desktop folder is unusable, or a write failed
#   2 - Bad option
#
# USAGE:
#   create-work-shortcuts                  # create / refresh a shortcut per project
#   create-work-shortcuts --dry-run
#   create-work-shortcuts --list
#   create-work-shortcuts --adopt --prune  # also take over hand-made ones, drop stale ones
#   create-work-shortcuts --exclude scratch --exclude archive
#   create-work-shortcuts -h | --help
#
# =============================================================================
set -uo pipefail

: "${BU:=$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)}"
source "$BU/lib/common.bash"
handle_help "$@"

MARKER="// generated by create-work-shortcuts"
MARKER_OLD="// generated by work-shortcuts"
LIST=0; DRY=0; ADOPT=0; PRUNE=0
W="${WORK:-}"; DESK=""
EXCLUDES=" ${WORK_SHORTCUTS_EXCLUDE:-} "

while [ $# -gt 0 ]; do
    case "$1" in
        --list) LIST=1 ;;
        --dry-run) DRY=1 ;;
        --adopt|--force) ADOPT=1 ;;
        --prune) PRUNE=1 ;;
        --exclude) [ $# -ge 2 ] || { err "--exclude needs a name"; exit 2; }; EXCLUDES="$EXCLUDES$2 "; shift ;;
        --work) [ $# -ge 2 ] || { err "--work needs a directory"; exit 2; }; W="$2"; shift ;;
        --desktop) [ $# -ge 2 ] || { err "--desktop needs a directory"; exit 2; }; DESK="$2"; shift ;;
        *) err "Unknown option: $1 (try --help)"; exit 2 ;;
    esac
    shift
done

# ---- Resolve $WORK and the Desktop ------------------------------------------
W="${W/#\~/$HOME}"
[ -n "$W" ] || { err "WORK is not set. Export WORK, or pass --work DIR."; exit 1; }
[ -d "$W" ] || { err "Work directory not found: $W"; exit 1; }
W="$(cd "$W" && pwd)"

if [ -z "$DESK" ]; then
    if [ "$(uname -s)" != Darwin ] && command -v xdg-user-dir >/dev/null 2>&1; then
        DESK="$(xdg-user-dir DESKTOP 2>/dev/null || true)"
    fi
    [ -n "$DESK" ] && [ -d "$DESK" ] || DESK="$HOME/Desktop"
fi
DESK="${DESK/#\~/$HOME}"
if [ ! -d "$DESK" ]; then
    info "No Desktop folder at $DESK (headless host?): nothing to do."
    exit 0
fi

STAMP="$(date +%Y%m%d-%H%M%S)"
BAK="$DESK/.work-shortcuts-bak"

# ---- Helpers ----------------------------------------------------------------
json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

render() { # absolute directory -> file content
    printf '%s\n{\n\t"folders": [\n\t\t{\n\t\t\t"path": "%s"\n\t\t}\n\t],\n\t"settings": {}\n}\n' \
        "$MARKER" "$(json_escape "$1")"
}

is_ours() { local first; first="$(head -n 1 "$1" 2>/dev/null)"; [ "$first" = "$MARKER" ] || [ "$first" = "$MARKER_OLD" ]; }

excluded() { case "$EXCLUDES" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# stash FILE: move it into the backup folder
stash() {
    mkdir -p "$BAK" && mv "$1" "$BAK/$(basename "$1").$STAMP" && info "Moved $(basename "$1") to $BAK/"
}

# first folder path of a generated file
target_of() { sed -n 's/^[[:space:]]*"path": "\(.*\)"[[:space:]]*$/\1/p' "$1" | head -n 1 | sed -e 's/\\"/"/g' -e 's/\\\\/\\/g'; }

created=0; updated=0; same=0; handmade=0; pruned=0; excl=0; failed=0
say() { printf '  %-22s %s\n' "$1" "$2"; }

# ---- Directories under $WORK -------------------------------------------------
for dir in "$W"/*/; do
    [ -d "$dir" ] || continue
    dir="${dir%/}"; name="$(basename "$dir")"
    file="$DESK/$name.code-workspace"
    if excluded "$name"; then say "$name" "excluded"; excl=$((excl + 1)); continue; fi
    want="$(render "$dir")"

    if [ ! -e "$file" ]; then
        state=new
    elif is_ours "$file"; then
        if [ "$(cat "$file")" = "$want" ]; then state=same; else state=changed; fi
    else
        state=handmade
    fi

    case "$state" in
        same)     say "$name" "up to date"; same=$((same + 1)) ;;
        new)
            if [ "$LIST" -eq 1 ] || [ "$DRY" -eq 1 ]; then say "$name" "would create"
            elif printf '%s\n' "$want" > "$file"; then say "$name" "created"; created=$((created + 1))
            else err "Could not write $file"; failed=1; fi
            [ "$LIST" -eq 1 ] || [ "$DRY" -eq 1 ] && created=$((created + 1)) ;;
        changed)
            if [ "$LIST" -eq 1 ] || [ "$DRY" -eq 1 ]; then say "$name" "would update (path or contents changed)"; updated=$((updated + 1))
            else
                stash "$file" && printf '%s\n' "$want" > "$file" && { say "$name" "updated"; updated=$((updated + 1)); } || { err "Could not update $file"; failed=1; }
            fi ;;
        handmade)
            if [ "$ADOPT" -eq 1 ]; then
                if [ "$LIST" -eq 1 ] || [ "$DRY" -eq 1 ]; then say "$name" "would adopt (hand-made file, backed up first)"; updated=$((updated + 1))
                else
                    stash "$file" && printf '%s\n' "$want" > "$file" && { say "$name" "adopted"; updated=$((updated + 1)); } || { err "Could not adopt $file"; failed=1; }
                fi
            else
                say "$name" "hand-made file left alone (use --adopt to replace it)"; handmade=$((handmade + 1))
            fi ;;
    esac
done

# ---- Stale shortcuts (--prune) -----------------------------------------------
for file in "$DESK"/*.code-workspace; do
    [ -f "$file" ] || continue
    is_ours "$file" || continue
    t="$(target_of "$file")"
    [ -n "$t" ] || continue
    [ -d "$t" ] && continue
    name="$(basename "$file")"
    if [ "$PRUNE" -eq 1 ]; then
        if [ "$LIST" -eq 1 ] || [ "$DRY" -eq 1 ]; then say "$name" "would prune (directory gone: $t)"; pruned=$((pruned + 1))
        else stash "$file" && { say "$name" "pruned (directory gone: $t)"; pruned=$((pruned + 1)); }; fi
    else
        say "$name" "stale: directory gone ($t); use --prune to remove"
    fi
done

# ---- Summary -----------------------------------------------------------------
verb=""; { [ "$LIST" -eq 1 ] || [ "$DRY" -eq 1 ]; } && verb="would be "
info "Desktop: $DESK   Work: $W"
info "${created} ${verb}created, ${updated} ${verb}updated, ${same} up to date, ${handmade} hand-made left alone, ${pruned} pruned, ${excl} excluded"
exit "$failed"
