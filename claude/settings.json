{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_CODE_MODE": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git rev-list *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-remote *)",
      "Bash(git ls-files *)",
      "Bash(git for-each-ref *)",
      "Bash(git check-ignore *)",
      "Bash(git remote *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git mv *)",
      "Bash(gh auth status *)",
      "Bash(gh repo view *)",
      "Bash(gh pr *)",
      "Bash(gh run *)",
      "Bash(gh api *)"
    ],
    "ask": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git branch -D *)",
      "Bash(gh api -X DELETE *)",
      "Bash(gh api --method DELETE *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "enableWeakerNetworkIsolation": true
  },
  "theme": "auto"
}
