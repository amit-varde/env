# Template for ~/.gitconfig. setup-env.sh --only dotfiles can fill in the two
# placeholders for you when you have no ~/.gitconfig yet; it never changes one you have.
[user]
	name = YOUR NAME
	email = YOUR_WORK_EMAIL
	# signingkey = YOUR_GPG_KEY_ID   # uncomment if you sign commits
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
# [commit]
#	gpgsign = true
# [tag]
#	gpgsign = true
[init]
	defaultBranch = main
[pull]
	rebase = true

# One identity per employer or account: git applies the extra file only to repos under
# that folder. Make ~/.gitconfig-<employer> with its own [user] block, then uncomment.
# (Adjust the folder if your WORK is not ~/work.)
# [includeIf "gitdir:~/work/<employer>/"]
#	path = ~/.gitconfig-<employer>
